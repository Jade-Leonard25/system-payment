{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "system-payroll-api",
  "main": "main.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Only public/ is uploaded as static assets; frontend-source/ is not deployed.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "system-payroll",
      "database_id": "96829657-7632-42a5-86c0-d037c2cf501c",
      "migrations_dir": "drizzle"
    }
  ]
}
